# Copier ce fichier en .env puis adapter. Ne JAMAIS committer .env.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
POSTGRES_DB=trading_journal
POSTGRES_USER=trading
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- CORS / CSRF (origines du frontend, séparées par des virgules) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Frontend ---
# Le navigateur appelle /api sur le frontend (proxy Next → backend, voir docker-compose.yml).
# Aucune variable NEXT_PUBLIC_* n'est nécessaire.

# --- Captures d'écran ---
STORAGE_BACKEND=local            # local (dossier storage/) ou s3
SCREENSHOT_MAX_BYTES=10485760    # 10 Mo par fichier (aussi à limiter côté reverse proxy)
SCREENSHOT_MAX_PIXELS=40000000   # anti « decompression bomb »
SCREENSHOT_MAX_FILES_PER_REQUEST=10
# Production S3 compatible (bucket PRIVÉ ; l'accès passe par des URL signées de 60 s) :
# STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_ENDPOINT_URL=               # vide pour AWS ; renseigné pour MinIO, Scaleway, R2…
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
