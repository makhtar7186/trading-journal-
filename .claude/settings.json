{
  "permissions": {
    "allow": [
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose exec backend pytest:*)",
      "Bash(docker compose exec backend python manage.py check:*)",
      "Bash(docker compose exec backend python manage.py makemigrations --check:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(npm run lint:*)",
      "Bash(npm test:*)",
      "Bash(npx tsc --noEmit:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.prod)",
      "Read(./backups/**)",
      "Bash(git push --force:*)",
      "Bash(docker compose down -v:*)"
    ]
  }
}
